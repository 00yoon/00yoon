# 수학 풀이 교실 환경변수 예시
# 로컬: 이 파일을 .env로 복사해 값을 채운 뒤 `docker run --env-file .env ...`
# Fly.io: 비밀값은 `fly secrets set 이름=값` 으로 넣으세요 (fly.toml에 쓰지 마세요)
# Railway: 서비스 → Variables 에 입력하세요
# .env 파일은 git에 올라가지 않습니다(.gitignore).

# 최초 관리자 계정. DB가 비어 있을 때(첫 실행) 한 번만 쓰입니다.
# 반드시 바꾸세요. 비워 두면 기본값 admin / admin1234 로 만들어집니다.
ADMIN_ID=admin
ADMIN_PASSWORD=change-me-to-a-long-password

# 데이터 폴더 (SQLite app.db + uploads/). 영구 디스크가 연결된 경로여야 합니다.
# Docker 이미지 기본값은 /data 입니다.
DATA_DIR=/data

# 서버 포트. Railway는 PORT를 자동으로 넣어 주므로 따로 지정하지 않아도 됩니다.
PORT=3000

NODE_ENV=production
